config BCM2836_L1_INTC
	bool "BCM2836 ARM-local interrupt controller"
	default y
	depends on DT_HAS_BRCM_BCM2836_L1_INTC_ENABLED
	help
	  Driver for the BCM2836 ARM-local interrupt controller (also
	  present on BCM2710 / Pi Zero 2 W). Routes per-core ARM
	  generic timer IRQs, four mailbox IRQs per core, the per-core
	  PMU IRQ, and the cascaded GPU IRQ to the parent controller of
	  the ARM CPU IRQ line.

config BCM2835_ARMCTRL_IC
	bool "BCM2835 ARMC peripheral interrupt controller"
	default y
	depends on DT_HAS_BRCM_BCM2835_ARMCTRL_IC_ENABLED
	help
	  Driver for the BCM2835 ARMC peripheral interrupt controller --
	  the "GPU IRQ" side of the BCM283x family. On BCM2710 (Pi Zero
	  2 W) it cascades under the BCM2836 ARM-local intc; on BCM2835
	  (Pi 1 / Pi Zero W) it is the root controller wired directly to
	  the ARM core IRQ line.

config RP1_IRQ
	bool "Raspberry Pi RP1 MSI-X interrupt controller"
	default y
	depends on DT_HAS_RASPBERRYPI_RP1_IRQ_ENABLED
	depends on ARM64
	depends on PCIE
	help
	  Driver for the interrupt controller of the RP1 PCIe south
	  bridge found on the Raspberry Pi 5. The RP1 raises one MSI-X
	  vector per internal interrupt source; the BCM2712 MSI
	  interrupt proxy converts each vector into a GIC SPI. The
	  driver programs the MSI-X table, unmasks the host side of the
	  proxy and exposes the RP1 sources above the GIC SPI range.

config RP1_IRQ_INIT_PRIORITY
	int "RP1 interrupt controller init priority"
	default 42
	depends on RP1_IRQ
	help
	  Initialisation priority of the RP1 interrupt controller. It
	  must run after the PCIe root complex (CONFIG_PCIE_INIT_PRIORITY)
	  because it reads the RP1 configuration space, and before the
	  serial drivers that enable RP1 UART interrupts.
